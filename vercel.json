{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/streaming",
      "destination": "/streaming/index.html"
    },
    {
      "source": "/rdg_ai",
      "destination": "/rdg_ai/index.html"
    },
    {
      "source": "/rdg_ai/:path*",
      "destination": "/rdg_ai/index.html"
    },
    {
      "source": "/api/pollinations",
      "destination": "https://text.pollinations.ai/"
    },
    {
      "source": "/api/pollinations/(.*)",
      "destination": "https://text.pollinations.ai/$1"
    },
    {
      "source": "/api/pollinations-img/(.*)",
      "destination": "https://image.pollinations.ai/$1"
    },
    {
      "source": "/api/tokenrouter/(.*)",
      "destination": "https://api.tokenrouter.com/v1/$1"
    },
    {
      "source": "/api/openrouter/(.*)",
      "destination": "https://openrouter.ai/api/v1/$1"
    }
  ]
}

